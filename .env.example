# CRM base URL (my-ticketing-system) — the sole cloud backend: CRM sign-in,
# teams, shared servers, and the notifications inbox all go through it.
# Baked into the app at `vite build` time — change requires a rebuild.
VITE_CRM_BASE_URL=http://localhost:8011

# Production example:
# VITE_CRM_BASE_URL=https://crm.beforth.in

# CI/CD (GitHub Actions):
# Set repo variable: Settings → Secrets and variables → Actions → Variables
# Name: VITE_CRM_BASE_URL
# Value: https://crm.beforth.in
