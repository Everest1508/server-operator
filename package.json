{
  "name": "server-operator",
  "version": "2.11.1",
  "description": "Premium server manager - deploy code, manage Docker, view logs",
  "author": {
    "name": "Ritesh Mahale",
    "email": "riteshmahale15@gmail.com"
  },
  "homepage": "https://github.com/everest1508",
  "main": "electron/main.js",
  "bin": {
    "server-operator-init": "scripts/server-operator-init.js",
    "serop": "scripts/serop.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron . --no-sandbox\"",
    "electron:build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder",
    "electron:build:linux": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --linux deb",
    "electron:build:mac": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --mac dmg zip",
    "electron:build:win": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --win",
    "website:serve": "npx --yes serve website -l 8788",
    "postinstall": "node scripts/copy-monaco.js",
    "ssh-connect": "node scripts/ssh-connect.js",
    "serop:init": "node scripts/server-operator-init.js",
    "serop:init:interactive": "node scripts/server-operator-init.js --interactive"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "ioredis": "^5.11.0",
    "lucide-react": "^0.460.0",
    "motion": "^12.40.0",
    "mysql2": "^3.22.4",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socks": "^2.8.3",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.server-operator.app",
    "productName": "Serop",
    "afterPack": "build/afterPack.mac.js",
    "publish": [{ "provider": "github", "owner": "everest1508", "repo": "server-operator", "releaseType": "release" }],
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "themes",
        "to": "themes"
      }
    ],
    "asarUnpack": [
      "node_modules/ssh2/**",
      "dist/vs/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "serop",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icons",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "pkg": {
      "scripts": "build/pkg-scripts",
      "installLocation": "/Applications"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serop",
      "uninstallDisplayName": "Serop",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 200,
          "type": "file"
        },
        {
          "x": 480,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
