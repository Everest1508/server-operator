{
  "name": "server-operator",
  "version": "2.0.1",
  "description": "Premium server manager - deploy code, manage Docker, view logs",
  "author": {
    "name": "Ritesh Mahale",
    "email": "riteshmahale15@gmail.com"
  },
  "homepage": "https://github.com/everest1508",
  "main": "electron/main.js",
  "bin": {
    "server-operator-init": "scripts/server-operator-init.js",
    "serop": "scripts/serop.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:${PORT:-5173} && ELECTRON_DEV=1 electron . --no-sandbox\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux deb",
    "electron:build:mac": "vite build && electron-builder --mac dmg zip",
    "electron:build:win": "vite build && electron-builder --win",
    "website:serve": "npx --yes serve website -l 8788",
    "postinstall": "mkdir -p public && cp -r node_modules/monaco-editor/min/vs public/ 2>/dev/null || true",
    "ssh-connect": "node scripts/ssh-connect.js",
    "serop:init": "node scripts/server-operator-init.js",
    "serop:init:interactive": "node scripts/server-operator-init.js --interactive"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "cloudinary": "^2.10.0",
    "ioredis": "^5.11.0",
    "lucide-react": "^0.460.0",
    "motion": "^12.40.0",
    "mysql2": "^3.22.4",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socks": "^2.8.3",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.server-operator.app",
    "productName": "Server Operator",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/ssh2/**",
      "dist/vs/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "serop",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Server Operator",
      "uninstallDisplayName": "Server Operator",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false
  }
}
